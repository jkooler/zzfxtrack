node_modules/
.DS_Store
output/
dist/
.agent/

# Strudel patterns: ignore everything by default
patterns/*.js
patterns/*.meta.json

# keep required file tracked
!patterns/index.js

# keep curated user starters tracked
!patterns/01-Introduction.js
!patterns/03-Blocks.js
!patterns/02-Monophonic-Horn.js

# keep system resources tracked
!patterns/01-Introduction-sys.js
!patterns/02-Monophon-Horn-sys.js
!patterns/03-Blocks-sys.js
!patterns/04-Diagnostic-sound-sys.js

# keep curated scope metadata tracked
!patterns/01-Introduction-sys.meta.json
!patterns/02-Monophon-Horn-sys.meta.json
!patterns/03-Blocks-sys.meta.json
!patterns/04-Diagnostic-sound-sys.meta.json

# Tracker blocks: ignore user-created/duplicated blocks (they live on disk but stay local)
blocks/*.js
# keep the blocks index (if present) so the folder is usable
!blocks/index.js

# Keep curated user arrangements tracked
!arrangements/01-Introduction.js

# User arrangements: ignore user-created arrangements (they live on disk but stay local)
arrangements/*.js
!arrangements/index.js

# User instruments: ignore generated instruments.js (user edits stay local)
instruments.js
