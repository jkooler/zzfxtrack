node_modules/
.DS_Store
output/
dist/
.agent/


# Strudel patterns: ignore everything by default
patterns/*.js
patterns/*.meta.json

# keep required file tracked
!patterns/index.js

# System patterns (tracked as part of codebase)
!patterns/01-Introduction.js
!patterns/01-Introduction.meta.json
!patterns/02-Monophonic-Horn.js
!patterns/02-Monophonic-Horn.meta.json
!patterns/03-Blocks.js
!patterns/03-Blocks.meta.json
!patterns/04-Diagnostic-sound.js
!patterns/04-Diagnostic-sound.meta.json

# Tracker blocks: ignore user-created blocks by default
blocks/*.js
!blocks/index.js

# System blocks (tracked as part of codebase)
!blocks/drums.js
!blocks/bass.js
!blocks/chords.js
!blocks/synths.js
!blocks/cowbell.js
!blocks/simple-drums.js
!blocks/simple-chords.js
!blcoks/simple-synths.js

# Arrangements: ignore user-created by default
arrangements/*.js
!arrangements/index.js

# System arrangements (tracked as part of codebase)
!arrangements/01-Introduction.js
!arrangements/02-Simple.js

# User instruments: ignore generated instruments.js (user edits stay local)
instruments.js

# Some old instruments backup
instruments_backup.js

.cursorrules
