node_modules/
.DS_Store
output/
dist/
.agent/

# Strudel patterns: ignore everything by default
patterns/*.js
patterns/*.meta.json

# keep required file tracked
!patterns/index.js

# keep curated user starters tracked
!patterns/01-Introduction.js
!patterns/02-Blocks.js
!patterns/03-Monophonic-Horn.js

# keep curated examples tracked
!patterns/00-Introduction-Demo.js
!patterns/01-Monophon-Horn-Demo.js
!patterns/02-Blocks-Demo.js
!patterns/03-Diagnostic-sound.js

# keep curated scope metadata tracked
!patterns/00-Introduction-Demo.meta.json
!patterns/01-Monophon-Horn-Demo.meta.json
!patterns/02-Blocks-Demo.meta.json
!patterns/03-Diagnostic-sound.meta.json

# Tracker blocks: ignore user-created/duplicated blocks (they live on disk but stay local)
blocks/*.js
# keep the blocks index (if present) so the folder is usable
!blocks/index.js
